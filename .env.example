# Copy this file to .env and fill in your own values. .env is gitignored — never commit real keys.

# OPTIONAL — free NCBI API key, only raises PubMed/ClinVar rate limits (3/sec -> 10/sec).
# The app works without it, just slower under heavy use. Get one at
# https://www.ncbi.nlm.nih.gov/account/settings/ (Settings -> API Key Management).
NCBI_API_KEY=

# OPTIONAL — NCBI asks that every E-utilities request identify a tool name and contact email.
# Any values are fine; this is not used for authentication.
NCBI_TOOL_NAME=clinical-variant-report-reviewer
NCBI_CONTACT_EMAIL=you@example.com

# REQUIRED for Phase 3 (AI report drafting). Free Gemini API key.
# Get one at https://aistudio.google.com/apikey (Google account, no payment info needed).
GEMINI_API_KEY=

# OPTIONAL locally, REQUIRED when deploying to Vercel — free Upstash Redis
# (via the Vercel Marketplace: `vercel integration add upstash/upstash-kv`,
# which sets KV_REST_API_URL/TOKEN automatically — @upstash/redis's
# Redis.fromEnv() accepts either that naming or UPSTASH_REDIS_REST_*, and
# review-store.ts's USE_REDIS check accepts both too). Without either pair
# set, review-store.ts falls back to local JSON files under data/annotated/
# — fine for running on your own laptop, but Vercel's serverless functions
# have a read-only filesystem in production, so the review/approve workflow
# needs real persistent storage there. See PLAN.md Phase 6 for why.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
