# Copy this file to .env and fill in your own values. .env is gitignored — never commit real keys.

# OPTIONAL — free NCBI API key, only raises PubMed/ClinVar rate limits (3/sec -> 10/sec).
# The app works without it, just slower under heavy use. Get one at
# https://www.ncbi.nlm.nih.gov/account/settings/ (Settings -> API Key Management).
NCBI_API_KEY=

# OPTIONAL — NCBI asks that every E-utilities request identify a tool name and contact email.
# Any values are fine; this is not used for authentication.
NCBI_TOOL_NAME=clinical-variant-report-reviewer
NCBI_CONTACT_EMAIL=you@example.com

# REQUIRED for Phase 3 (AI report drafting). Free Gemini API key.
# Get one at https://aistudio.google.com/apikey (Google account, no payment info needed).
GEMINI_API_KEY=
